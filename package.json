{
  "name": "shipi18n-github-action",
  "version": "2.0.0",
  "description": "GitHub Action to translate i18n locale files with your own OpenAI/Anthropic key. No hosted API.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "test": "jest",
    "lint": "eslint src/**/*.js"
  },
  "keywords": [
    "github-action",
    "i18n",
    "translation",
    "localization",
    "llm",
    "openai",
    "anthropic",
    "bring-your-own-key",
    "automation"
  ],
  "author": "Shipi18n",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.114.0",
    "@shipi18n/core": "^2.0.0",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "jest": "^29.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shipi18n/shipi18n-github-action.git"
  }
